{
  "name": "notes-rest-api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc-watch --onSuccess \"env-cmd -f ./config/dev.env node dist/index.js\"",
    "test": "tsc-watch --onSuccess \"env-cmd -f ./config/test.env node dist/index.js\"",
    "db:test": "docker compose -f ./docker-compose.test.yml up -d",
    "db:test:down": "docker compose -f ./docker-compose.test.yml down -v",
    "coverage": "env-cmd -f ./config/test.env vitest run --coverage --coverage.include **/src/*",
		"prettier": "prettier --write .",
		"lint": "eslint . --ext .ts"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^4.1.5",
    "env-cmd": "^11.0.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsc-watch": "^7.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^5.7.0",
    "validator": "^13.15.35"
  }
}
